{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "strict": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "exclude": [
    "dist",
    "node_modules",
    "server"
  ]
}
